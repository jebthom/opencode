{
  "name": "aperture",
  "displayName": "Aperture",
  "description": "Aperture marks in the editor gutter and a facet-chip file tree",
  "version": "0.0.1",
  "publisher": "sst-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aperture",
          "title": "Aperture",
          "icon": "media/aperture.svg"
        }
      ]
    },
    "views": {
      "aperture": [
        {
          "id": "aperture.openEditors",
          "name": "Open Editors",
          "visibility": "collapsed"
        },
        {
          "id": "aperture.fileTree",
          "name": "Files"
        }
      ]
    },
    "commands": [
      {
        "command": "aperture.repaint",
        "title": "Aperture: Repaint active editor"
      },
      {
        "command": "aperture.filterFacets",
        "title": "Aperture: Filter facets",
        "icon": "$(filter)"
      },
      {
        "command": "aperture.clearFacetFilter",
        "title": "Aperture: Clear the facet filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "aperture.refreshTree",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "aperture.revealActiveFile",
        "title": "Aperture: Reveal the active file in the Aperture tree"
      },
      {
        "command": "aperture.newFile",
        "title": "New File...",
        "icon": "$(new-file)"
      },
      {
        "command": "aperture.newFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "aperture.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "aperture.rename",
        "title": "Rename..."
      },
      {
        "command": "aperture.delete",
        "title": "Delete"
      },
      {
        "command": "aperture.findInFolder",
        "title": "Find in Folder..."
      },
      {
        "command": "aperture.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "aperture.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "aperture.revealInOS",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "aperture.revealInExplorer",
        "title": "Reveal in VS Code Explorer"
      },
      {
        "command": "aperture.closeTab",
        "title": "Close Editor",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aperture.newFile",
          "when": "view == aperture.fileTree",
          "group": "navigation@1"
        },
        {
          "command": "aperture.newFolder",
          "when": "view == aperture.fileTree",
          "group": "navigation@2"
        },
        {
          "command": "aperture.filterFacets",
          "when": "view == aperture.fileTree",
          "group": "navigation@3"
        },
        {
          "command": "aperture.refreshTree",
          "when": "view == aperture.fileTree",
          "group": "navigation@4"
        },
        {
          "command": "aperture.clearFacetFilter",
          "when": "view == aperture.fileTree",
          "group": "1_filter"
        }
      ],
      "view/item/context": [
        {
          "command": "aperture.openToSide",
          "when": "view == aperture.fileTree && viewItem == apertureFile",
          "group": "1_open@1"
        },
        {
          "command": "aperture.revealInOS",
          "when": "view == aperture.fileTree",
          "group": "1_open@2"
        },
        {
          "command": "aperture.revealInExplorer",
          "when": "view == aperture.fileTree",
          "group": "1_open@3"
        },
        {
          "command": "aperture.newFile",
          "when": "view == aperture.fileTree && viewItem == apertureFolder",
          "group": "2_new@1"
        },
        {
          "command": "aperture.newFolder",
          "when": "view == aperture.fileTree && viewItem == apertureFolder",
          "group": "2_new@2"
        },
        {
          "command": "aperture.findInFolder",
          "when": "view == aperture.fileTree && viewItem == apertureFolder",
          "group": "3_find@1"
        },
        {
          "command": "aperture.copyPath",
          "when": "view == aperture.fileTree",
          "group": "4_copy@1"
        },
        {
          "command": "aperture.copyRelativePath",
          "when": "view == aperture.fileTree",
          "group": "4_copy@2"
        },
        {
          "command": "aperture.rename",
          "when": "view == aperture.fileTree",
          "group": "5_modify@1"
        },
        {
          "command": "aperture.delete",
          "when": "view == aperture.fileTree",
          "group": "5_modify@2"
        },
        {
          "command": "aperture.closeTab",
          "when": "view == aperture.openEditors && viewItem == apertureTab",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Aperture",
      "properties": {
        "aperture.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host of the running opencode server."
        },
        "aperture.port": {
          "type": "number",
          "default": 4096,
          "description": "Port of the running opencode server (the port passed to `opencode --port`)."
        },
        "aperture.tree.chipLayout": {
          "type": "string",
          "enum": [
            "bar6",
            "bar-proportional",
            "mosaic6"
          ],
          "enumDescriptions": [
            "Equal cells in one row, apportioned to facets by byte share \u2014 six, or one per facet where the node carries more. Cells are ~2.7px wide.",
            "One row, with segment widths as the true byte shares and a floor so a small facet stays visible.",
            "Three columns of two, with the right-hand column split vertically into four narrow cells. Cells are ~5.3x7px (~2.7x7px in the split third), so individual facets are far easier to pick out and every facet present is guaranteed one."
          ],
          "default": "mosaic6",
          "description": "How the Aperture tree's facet chip encodes a file's composition."
        },
        "aperture.tree.iconDelivery": {
          "type": "string",
          "enum": [
            "data",
            "file"
          ],
          "enumDescriptions": [
            "Inline the chip SVG as a data: URI. Simpler, with no files on disk.",
            "Write the chip SVG under the extension's storage and reference it as a file. Use this if chips render blank."
          ],
          "default": "data",
          "description": "How generated chip SVGs are handed to VSCode."
        },
        "aperture.tree.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Reveal and select the active editor's file in the Aperture tree."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "package": "bun run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "20.x",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3"
  }
}
